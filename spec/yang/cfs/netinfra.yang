module netinfra {
  yang-version "1.1";
  namespace "http://example.com/netinfra";
  prefix "netinfra";
  description "Network Infrastructure";
  revision 2019-01-01 {
    description "test revision";
    reference "ref1";
  }
  import ietf-inet-types {
    prefix inet;
  }
  import stratoweave {
    prefix sw;
  }
  import ietf-yang-tmf-map {
    prefix tmf;
  }

  container netinfra {
    description "Network infrastructure";
    list router {
      description "Network Infrastructure Router";
      key name;

      sw:transform sorespo.cfs.Router;
      tmf:cfs-service "Router";
      sw:link global {
        sw:path /netinfra:netinfra/netinfra:global-settings;
      }

      leaf name {
        type string;
      }
      leaf id {
        type uint32;
        description "router id";
        mandatory true;
      }
      leaf type {
        type string;
        mandatory true;
      }
      leaf role {
        type string;
      }
      leaf asn {
        type inet:as-number;
        mandatory true;
      }
      leaf mock {
        type boolean;
        default false;
      }
      leaf approval-required {
        type boolean;
        default false;
      }
      container feature-flags {
        leaf runtime-schema-fetch {
          type boolean;
          default false;
        }
      }
    }

    list backbone-link {
      key "left-router left-interface right-router right-interface";

      sw:transform sorespo.cfs.BBLink;
      tmf:cfs-service "Backbone Link";

      leaf left-router {
        type string;
      }
      leaf left-interface {
        type string;
      }
      leaf right-router {
        type string;
      }
      leaf right-interface {
        type string;
      }
      leaf monitor-traffic {
        type boolean;
        default false;
      }
      container state {
        config false;
        description
          "Operational state lifted from the underlying RFS backbone-interface entries.
           left-pps is the receive PPS measured on the left interface (traffic flowing right -> left);
           right-pps is the receive PPS measured on the right interface (traffic flowing left -> right).
           link-status is the combined oper-state of the two endpoints
           (up only when both endpoints are up; down if either is down;
           unknown when either endpoint's oper-state is unavailable).";
        leaf left-pps {
          type uint64;
        }
        leaf right-pps {
          type uint64;
        }
        leaf link-status {
          type enumeration {
            enum up;
            enum down;
            enum unknown;
          }
        }
      }
    }

    list peering-interface {
      key "router name";

      sw:transform sorespo.cfs.PeeringInterface;
      tmf:cfs-service "Peering Interface";

      leaf router {
        type string;
        description "Managed router on which to configure the interface.";
      }
      leaf name {
        type string;
        description "Interface facing the external network.";
      }
      leaf ipv4-address {
        type inet:ipv4-address;
        mandatory true;
      }
      leaf ipv4-prefix-length {
        type uint8 {
          range "1..32";
        }
        default "24";
      }
      leaf-list secondary-ipv4-address {
        type inet:ipv4-address;
        description
          "Additional local addresses in the same prefix, used when distinct
           source addresses are required for multiple peer sessions.";
      }
      leaf description {
        type string;
      }
    }

    list ebgp-peer {
      key "router peer-address";

      sw:transform sorespo.cfs.EbgpPeer;
      tmf:cfs-service "eBGP Peer";

      leaf router {
        type string;
        description "Router on which to configure the session.";
      }
      leaf peer-address {
        type inet:ipv4-address;
      }
      leaf local-address {
        type inet:ipv4-address;
        description
          "Optional source address for this session. The address must be
           configured on a peering interface.";
      }
      leaf peer-asn {
        type inet:as-number;
        mandatory true;
      }
      leaf description {
        type string;
      }
      container state {
        config false;
        leaf session-state {
          type enumeration {
            enum idle;
            enum connect;
            enum active;
            enum open-sent;
            enum open-confirm;
            enum established;
            enum unknown;
          }
        }
      }
    }

    container global-settings {
      sw:transform sorespo.cfs.GlobalSettings;
      description
        "Network-wide settings shared across all routers.";
      leaf ibgp-authentication-key {
        type string;
        mandatory true;
        description
          "Shared iBGP authentication key applied to every router's
           iBGP full-mesh neighbors.";
      }
    }
  }
}
