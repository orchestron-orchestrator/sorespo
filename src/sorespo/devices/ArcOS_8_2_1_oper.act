      "RFC7810: IS-IS Traffic Engineering (TE) Metric Extensions.";
  }

  identity TLV222_LINK_DELAY_VARIATION {
    base "ISIS_TLV222_SUBTLVS_TYPE";
    description
      "sub-TLV 35. Unidirectional Link Delay Variation.";
    reference
      "RFC7810: IS-IS Traffic Engineering (TE) Metric Extensions.";
  }

  identity TLV222_LINK_LOSS {
    base "ISIS_TLV222_SUBTLVS_TYPE";
    description
      "sub-TLV 36. Unidirectional Link Loss Delay.";
    reference
      "RFC7810: IS-IS Traffic Engineering (TE) Metric Extensions.";
  }

  identity TLV222_RESIDUAL_BANDWIDTH {
    base "ISIS_TLV222_SUBTLVS_TYPE";
    description
      "sub-TLV 37. Unidirectional Residual Bandwidth.";
    reference
      "RFC7810: IS-IS Traffic Engineering (TE) Metric Extensions.";
  }

  identity TLV222_AVAILABLE_BANDWIDTH {
    base "ISIS_TLV222_SUBTLVS_TYPE";
    description
      "sub-TLV 38. Unidirectional Available Bandwidth.";
    reference
      "RFC7810: IS-IS Traffic Engineering (TE) Metric Extensions.";
  }

  identity TLV222_UTILIZED_BANDWIDTH {
    base "ISIS_TLV222_SUBTLVS_TYPE";
    description
      "sub-TLV 39. Unidirectional Utilized Bandwidth.";
    reference
      "RFC7810: IS-IS Traffic Engineering (TE) Metric Extensions.";
  }

  identity TLV223_ADMIN_GROUP {
    base "ISIS_TLV223_SUBTLVS_TYPE";
    description
      "sub-TLV 3. Administrative group(color).";
    reference
      "RFC5305: IS-IS Extensions for Traffic Engineering";
  }

  identity TLV223_IPV4_INTERFACE_ADDRESS {
    base "ISIS_TLV223_SUBTLVS_TYPE";
    description
      "sub-TLV 6. IPv4 Interface Address.";
    reference
      "RFC5305: IS-IS Extensions for Traffic Engineering.";
  }

  identity TLV223_IPV4_NEIGHBOR_ADDRESS {
    base "ISIS_TLV223_SUBTLVS_TYPE";
    description
      "sub-TLV 6. IPv4 Neighbor Address.";
    reference
      "RFC5305: IS-IS Extensions for Traffic Engineering.";
  }

  identity TLV223_MAX_LINK_BANDWIDTH {
    base "ISIS_TLV223_SUBTLVS_TYPE";
    description
      "sub-TLV 9. Maximum Link Bandwidth.";
    reference
      "RFC5305: IS-IS Extensions for Traffic Engineering.";
  }

  identity TLV223_MAX_RESERVABLE_BANDWIDTH {
    base "ISIS_TLV223_SUBTLVS_TYPE";
    description
      "sub-TLV 10. Maximum Reservable Bandwidth.";
    reference
      "RFC5305: IS-IS Extensions for Traffic Engineering.";
  }

  identity TLV223_UNRESERVED_BANDWIDTH {
    base "ISIS_TLV223_SUBTLVS_TYPE";
    description
      "sub-TLV 11. Unreserved bandwidth.";
    reference
      "RFC5305: IS-IS Extensions for Traffic Engineering.";
  }

  identity TLV223_IPV6_INTERFACE_ADDRESS {
    base "ISIS_TLV223_SUBTLVS_TYPE";
    description
      "sub-TLV 12. IPv6 Interface Address.";
    reference
      "RFC6119: IPv6 Traffic Engineering in IS-IS.";
  }

  identity TLV223_IPV6_NEIGHBOR_ADDRESS {
    base "ISIS_TLV223_SUBTLVS_TYPE";
