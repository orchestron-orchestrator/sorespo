SRC_YANG_160: str = r"""module arcos-openconfig-network-instance-augments-deviations {
  yang-version 1.1;
  namespace "http://yang.arrcus.com/arcos/openconfig/network-instance/augments/deviations";
  prefix arc-oc-netinst-aug-dev;

  import openconfig-network-instance {
    prefix oc-ni;
