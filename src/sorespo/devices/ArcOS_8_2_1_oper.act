      "IANA 'ifType definitions' registry.
       &lt;http://www.iana.org/assignments/smi-numbers&gt;";

  revision 2014-05-08 {
    description
      "Initial revision.";
    reference
      "RFC 7224: IANA Interface Type YANG Module";
  }

  identity iana-interface-type {
    base if:interface-type;
    description
