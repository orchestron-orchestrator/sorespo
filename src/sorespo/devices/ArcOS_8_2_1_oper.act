    "This module contains definitions for the
     ArcOS Network instance augments.
     Copyright (c) 2023 by Arrcus, Inc.
     All rights reserved.";

  revision 2023-11-09 {
    description "Initial revision.";
  }

  augment "/oc-platform:components/oc-platform:component/oc-platform:power-supply/oc-platform:state" {
    leaf input-power {
      type uint32;
      units watts;
    }
    description
      "Input power supplied by Power supply in watts";
  }
}
"""

