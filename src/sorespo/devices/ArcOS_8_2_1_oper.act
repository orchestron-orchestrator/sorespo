    description "MPLS LDP signaling-protocols configuration is only valid with the default network instance.";
  }

  deviation "/oc-netinst:network-instances" +
            "/oc-netinst:network-instance/oc-netinst:mpls" +
	    "/oc-netinst:signaling-protocols/oc-netinst:ldp" +
	    "/oc-netinst:interface-attributes/oc-netinst:interfaces" +
	    "/oc-netinst:interface" {
