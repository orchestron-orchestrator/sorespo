/*deviation "/oc-netinst:network-instances/oc-netinst:network-instance" +
    "/oc-netinst:fdb/oc-netinst:mac-table/oc-netinst:entries/oc-netinst:entry/oc-netinst:interface" +
    "/oc-netinst:interface-ref/oc-netinst:state/oc-netinst:subinterface" {
    deviate not-supported;
    description "Not supported in this release";
