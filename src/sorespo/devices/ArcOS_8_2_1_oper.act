      "Replacement of type due to OpenConfig non-compliance with YANG 1.0/1.1 pattern statement";
  }

  deviation "/oc-sys:system/oc-sys:logging/oc-sys:remote-servers" +
            "/oc-sys:remote-server/oc-sys:state/oc-sys:host" {
    deviate replace {
      type inet:host;
    }
    description
