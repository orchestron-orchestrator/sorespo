   */
  deviation "/oc-netinst:network-instances/oc-netinst:network-instance" +
            "/oc-netinst:protocols/oc-netinst:protocol" +
            "/oc-netinst:bgp" +
            "/oc-netinst:peer-groups/oc-netinst:peer-group" +
            "/oc-netinst:afi-safis/oc-netinst:afi-safi/oc-netinst:ipv4-unicast" +
            "/oc-netinst:prefix-limit/oc-netinst:config" {
    deviate add {
      must "boolean(oc-netinst:max-prefixes) or " +
           "(boolean(oc-netinst:prevent-teardown) != 'true' and" +
           " boolean(oc-netinst:warning-threshold-pct) != 'true' and" +
           " boolean(oc-netinst:restart-timer) != 'true')" {
        error-message "'max-prefixes' must be configured for prefix-limit.";
      }
    }
  }

