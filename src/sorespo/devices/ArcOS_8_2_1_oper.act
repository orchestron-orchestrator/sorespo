      must "boolean(oc-netinst:max-prefixes) or " +
           "(boolean(oc-netinst:prevent-teardown) != 'true' and" +
           " boolean(oc-netinst:warning-threshold-pct) != 'true' and" +
           " boolean(oc-netinst:restart-timer) != 'true')" {
