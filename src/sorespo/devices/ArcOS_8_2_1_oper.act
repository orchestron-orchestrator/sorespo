      must "(derived-from-or-self(" +
           "../../../../../../oc-netinst:config/oc-netinst:type," +
           "'oc-ni-types:L3VRF') and " +
           "../../../../../../oc-netinst:config/oc-netinst:name" +
           " = 'default')" {
