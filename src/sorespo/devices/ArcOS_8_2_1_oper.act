    description "Not supported in this release.";
  }

  deviation "/nat:nat/nat:instances/nat:instance/nat:statistics/nat:discontinuity-time" {
    deviate not-supported;
    description "Not supported in this release.";
  }
  deviation "/nat:nat/nat:instances/nat:instance/nat:statistics/nat:traffic-statistics/nat:sent-packets" {
