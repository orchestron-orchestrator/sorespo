            "/oc-acl:destination-flow-label" {
    deviate not-supported;
    description "Do not support ipv6 destination-flow-label in this release";
  }

  deviation "/oc-acl:acl/oc-acl:acl-sets/oc-acl:acl-set/oc-acl:acl-entries" +
