      "Support to read firmware version";
  }

  revision 2025-06-04 {
    description
      "Added support for SNMP inform options";
  }

  revision 2025-04-25 {
    description
      "Updated listen-addresses must validation statement";
  }

  revision 2025-03-25 {
    description
      "Added component logging for TWAMP";
  }

  revision "2025-02-04" {
    description 
      "changed default value of listen-addresses in grpc-server connections";
  }
  
  revision 2025-01-27 {
    description
      "Added support for VRF aware ICMP source interface .";
  }

  revision "2025-01-20" {
    description 
      "added connections list to grpc-server";
  }

  revision 2024-12-02 {
    description
      "Remove MPLS-OAM tech support debug state";
