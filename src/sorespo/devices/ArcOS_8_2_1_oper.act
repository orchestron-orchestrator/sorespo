    description "Not supported in this release.";
  }
  deviation "/nat:nat/nat:instances/nat:instance/nat:mapping-table/nat:mapping-entry/nat:internal-dst-address" {
    deviate not-supported;
    description "Not supported in this release.";
  }
  deviation "/nat:nat/nat:instances/nat:instance/nat:mapping-table/nat:mapping-entry/nat:internal-dst-port" {
