      }

      leaf afi {
        type uint16;
        description
          "IANAs address family";
      }

      leaf length {
        type uint8;
        description
          "Lenght of the root LSRs address";
      }

      leaf root-node-address {
        type inet:ip-address;
        description
          "Root node address";
      }
    }
