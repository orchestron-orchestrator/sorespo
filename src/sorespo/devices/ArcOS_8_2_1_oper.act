  description
    "This module defines deviation statements for Arrcus
     implemention of the openconfig network instance module.";

  revision 2024-10-18 {
    description
      "Add extension for table-connection";
  }

  revision 2019-01-05 {
    description
      "Initial Revision";

    reference
      "RFC 7950: The YANG 1.1 Data Modeling Language";
