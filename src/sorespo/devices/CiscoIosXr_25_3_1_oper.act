                          range "1..255" {
                            description
                              "Index";
                          }
                        }
                        must 'not(../disable)';
                        description
                          "Set preference order among tiebreakers";
                      }
                      container disable {
                        must 'not(../index)';
                        presence "Indicates a disable node is configured.";
                        description
                          "Disable tiebreaker";
                      }
                    }
                    container primary-path {
                      description
