                            leaf interface-name {
                              type xr:Interface-name;
                              description
                                "Forwarding interface";
                            }
                            leaf address {
                              type inet:ip-address-no-zone;
                              description
                                "Forwarding router's address";
                            }
                            container bfd {
                              description
