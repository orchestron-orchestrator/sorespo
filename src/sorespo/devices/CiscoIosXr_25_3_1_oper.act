                      list ipv6-address {
                        key "address remote-port vrf";
                        description
                          "Enter IPv6 address of the remote interface";
                        leaf address {
                          type union {
                            type inet:ipv6-address-no-zone;
                            type string {
                              pattern 'any ipv6' {
                                description
                                  "Enter 'any ipv6' string for IPv6 address of the remote interface";
