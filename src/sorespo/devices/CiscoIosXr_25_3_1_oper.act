            leaf cryptographic-algorithm {
              type enumeration {
                enum md5 {
                  value 3;
                  description
                    "Configure MD5 as cryptographic algorithm";
                }
                enum sha-1 {
                  value 4;
                  description
                    "Configure SHA-1-20 as cryptographic algorithm";
                }
                enum hmac-md5 {
                  value 5;
                  description
                    "Configure HMAC-MD5 as cryptographic algorithm";
