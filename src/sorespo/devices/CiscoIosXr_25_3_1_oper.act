                      }
                    }
                    container secondary-path {
                      description
                        "Prefer non-ECMP backup path";
                      leaf index {
                        type uint32 {
                          range "1..255" {
                            description
                              "Index";
                          }
                        }
                        must 'not(../disable)';
                        description
                          "Set preference order among tiebreakers";
                      }
                      container disable {
                        must 'not(../index)';
                        presence "Indicates a disable node is configured.";
                        description
                          "Disable tiebreaker";
                      }
