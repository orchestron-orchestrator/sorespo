                  }
                  enum login {
                    value 513;
                    description
                      "Login (rlogin, 513)";
                  }
                  enum cmd {
                    value 514;
                    description
                      "Remote commands (rcmd, 514)";
                  }
                  enum lpd {
                    value 515;
                    description
                      "Printer service (515)";
                  }
                  enum uucp {
                    value 540;
                    description
                      "Unix-to-Unix Copy Program (540)";
                  }
                  enum klogin {
                    value 543;
                    description
                      "Kerberos login (543)";
                  }
                  enum kshell {
                    value 544;
                    description
                      "Kerberos shell (544)";
                  }
                  enum talk {
                    value 517;
                    description
                      "Talk (517)";
                  }
                  enum ldp {
                    value 646;
                    description
                      "LDP session connection attempts (MPLS, 646)";
                  }
                }
              }
              description
                "Match only packets on a given port range";
            }
            leaf upper-port-range {
              type union {
                type uint32 {
                  range "0..65535" {
                    description
                      "Port number";
                  }
                }
                type enumeration {
                  enum echo {
                    value 7;
