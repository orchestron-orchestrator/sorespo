                      description
                        "Microloop-avoidance log";
                    }
                    enum route {
                      value 5;
                      description
                        "Route log";
                    }
                    enum spf {
                      value 6;
                      description
                        "SPF log";
                    }
                  }
                  description
                    "Log type";
