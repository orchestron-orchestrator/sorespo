SRC_YANG_204: str = r"""module Cisco-IOS-XR-um-traps-ipsec-cfg {

  /*** NAMESPACE / PREFIX DEFINITION ***/

  namespace "http://cisco.com/ns/yang/Cisco-IOS-XR-um-traps-ipsec-cfg";
  prefix um-traps-ipsec-cfg;

  /*** LINKAGE (IMPORTS / INCLUDES) ***/

