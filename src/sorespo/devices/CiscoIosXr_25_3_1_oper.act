          }
          must '../basic and ../holddown and ../flush';
          description
            "Invalid";
        }
        leaf holddown {
          type uint32 {
            range "15..200000" {
              description
                "Holddown";
            }
          }
          must '../invalid and ../basic and ../flush';
          description
            "Holddown";
        }
        leaf flush {
          type uint32 {
            range "16..250000" {
              description
                "Flush";
            }
          }
          must '../invalid and ../holddown and ../basic';
          description
            "Flush";
        }
