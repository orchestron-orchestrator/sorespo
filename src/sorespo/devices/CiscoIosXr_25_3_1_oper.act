                    }
                    enum february {
                      value 1;
                      description
                        "February";
                    }
                    enum march {
                      value 2;
                      description
                        "March";
                    }
                    enum april {
                      value 3;
                      description
                        "April";
                    }
                    enum may {
                      value 4;
                      description
                        "May";
                    }
                    enum june {
                      value 5;
                      description
                        "June";
                    }
                    enum july {
                      value 6;
                      description
                        "July";
                    }
                    enum august {
                      value 7;
                      description
                        "August";
                    }
                    enum september {
                      value 8;
                      description
                        "September";
                    }
                    enum october {
                      value 9;
                      description
                        "October";
                    }
                    enum november {
                      value 10;
                      description
                        "November";
                    }
                    enum december {
                      value 11;
                      description
                        "December";
                    }
                  }
                  mandatory true;
