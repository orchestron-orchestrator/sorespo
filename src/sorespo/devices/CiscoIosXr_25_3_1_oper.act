            leaf safi-unicast {
              type enumeration {
                enum enable {
                  value 1;
                  description
                    "Advertise routes with local-label via Unicast SAFI";
                }
                enum disable {
                  value 2;
                  description
                    "Do not advertise routes with local-label via Unicast SAFI";
                }
              }
              description
                "Advertisement of routes with local-label via Unicast SAFI";
            }
          }
