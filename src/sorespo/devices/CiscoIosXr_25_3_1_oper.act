                  description
                    "bbe-p threshold range";
                }
              }
              description
                "set bbe-p threshold";
            }
            leaf bber-p {
              type uint32 {
                range "0..100000" {
                  description
                    "bber-p threshold range";
                }
              }
              description
                "set bber-p threshold";
            }
            leaf uas-p {
              type uint32 {
                range "0..86400" {
                  description
                    "uas-p threshold range";
                }
              }
              description
                "set uas-p threshold";
            }
          }
          container reports {
            description
              "set ho_vc TCA reporting status";
            list report {
              must 'enable or disable';
              key "report-id";
              description
                "set ho_vc TCA reporting status";
              leaf report-id {
                type enumeration {
                  enum eb-p {
                    value 33554432;
                    description
                      "set eb TCA reporting status";
                  }
                  enum es-p {
                    value 33554433;
                    description
                      "set es TCA reporting status";
                  }
                  enum esr-p {
                    value 33554434;
                    description
                      "set esr TCA reporting status";
                  }
                  enum ses-p {
                    value 33554435;
                    description
                      "set ses TCA reporting status";
                  }
                  enum sesr-p {
                    value 33554436;
                    description
                      "set sesr TCA reporting status";
                  }
                  enum bbe-p {
                    value 33554437;
                    description
                      "set bbe TCA reporting status";
                  }
                  enum bber-p {
                    value 33554438;
                    description
                      "set bber TCA reporting status";
                  }
