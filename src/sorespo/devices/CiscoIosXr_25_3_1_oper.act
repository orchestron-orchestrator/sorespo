          description
            "Monitoring interval for the metric computation";
          leaf duration {
            description
              "Duration of the fixed interval";
            type uint16 {
              range "10..300" {
                description
                  "duration in seconds";
              }
            }
          }
        }
        leaf history {
          description
            "Limit num history intervals for each flow in this policy class";
          type uint8 {
            range "1..60" {
              description
                "Num intervals of history";
            }
