            container enable {
              must 'not(../disable)';
              presence "Indicates a enable node is configured.";
              description
                "Enable passive";
            }
            container disable {
              must 'not(../enable)';
              presence "Indicates a disable node is configured.";
              description
                "Disable passive";
            }
