                leaf log-type {
                  type enumeration {
                    enum adjacency {
                      value 0;
                      description
                        "Adjacency log";
                    }
                    enum database {
                      value 1;
                      description
                        "Database log";
                    }
                    enum error {
                      value 2;
                      description
                        "Error log";
