                    DLeaf(module='ietf-l3vpn-svc', namespace='urn:ietf:params:xml:ns:yang:ietf-l3vpn-svc', prefix='l3vpn-svc', name='type', config=True, description='Type of VPN Policy filter.', mandatory=False, type=DTypeIdentityref(name='identityref', description=None, reference=None, exts=[], builtin_type='identityref', default=None, identity_bases=[_base_ietf_l3vpn_svc_vpn_policy_filter_type], identities=_identities)),
