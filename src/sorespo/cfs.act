import yang.adata
import yang.gdata as gdata
import stratoweave.ttt as ttt

import sorespo.layers.base_0 as base
import sorespo.layers.y_1_loose as y_1_loose
import sorespo.layers.y_0 as y_0
import sorespo.layers.y_0_oper as y_0_oper
import sorespo.layers.y_1_oper as y_1_oper
# TODO: this import is required by the compiler, maybe related to
# https://github.com/actonlang/acton/issues/2390
import yang.identityref


class GlobalSettings(base.GlobalSettings):
    def transform(self, i):
        print("CFS global-settings transform running", err=True)
        return base.o_root()


class Router(base.Router):
    def transform(self, i, linked):
        o = base.o_root()
        print("CFS router transform running", i.name, i.id)
        o_router = o.netinfra.router.create(i.name, id=i.id, type=i.type, role=i.role, mock=i.mock, approval_required=i.approval_required)
        o_router.feature_flags.runtime_schema_fetch = i.feature_flags.runtime_schema_fetch

        # Assign the loopback interface addresses
        bc = o_router.base_config
        bc.ipv4_address = "10.0.0.{i.id}"
        bc.ipv6_address = "2001:db8:0:0::{i.id}"
        bc.asn = i.asn

        # Source the iBGP authentication key from the network-wide
        # global-settings, linked via /netinfra:netinfra/global-settings.
        gs = y_0.root.from_gdata(linked).netinfra.global_settings

        fm = o.netinfra.ibgp_fullmesh.create(i.asn, gs.ibgp_authentication_key)
        fm.router.create(i.name, bc.ipv4_address)

        return o


class BBLink(base.BBLink):
    def transform(self, i):
        print("CFS backbonelink transform running %s [%s] <-> %s [%s]" % (i.left_router, i.left_interface, i.right_router, i.right_interface))
        o = base.o_root()
        bblink = o.netinfra.backbone_link.create((i.left_router, i.left_interface, i.right_router, i.right_interface))

        if i.optical is not None:
            bblink.optical.vlan = i.optical.vlan
            bblink.optical.left_roadm = i.optical.left_roadm
            bblink.optical.left_port = i.optical.left_port
            bblink.optical.right_roadm = i.optical.right_roadm
            bblink.optical.right_port = i.optical.right_port
        return o


# --- Backbone link oper-status lift -------------------------------------------
# Lift the inter backbone-link link-status onto the CFS backbone-link so it is
# served at data/netinfra:netinfra/backbone-link
actor BBLinkTransform(path: ttt.Path,
                      update_oper: proc(?y_0_oper.netinfra__netinfra__backbone_link_entry)->None,
                      lower_tree_provider: ?gdata.TreeProvider):
    _oper = base.BBLink.new_state(path)
    _subs = gdata.SubscriptionManager(lower_tree_provider!, str(path))

    def on_inter_state(root: ?y_1_oper.root, err: ?Exception, left_router: str, left_interface: str, right_router: str, right_interface: str):
        if err is not None:
            print("cfs.BBLinkTransform inter subscription error: {err}", err=True)
            return
        link_status: ?str = None
        if root is not None:
            for bl in root.netinfra.backbone_link:
                if bl.left_router == left_router and bl.left_interface == left_interface and bl.right_router == right_router and bl.right_interface == right_interface:
                    link_status = bl.state.link_status
        _oper.state.link_status = link_status
        update_oper(_oper)

    def on_conf(conf: y_0.netinfra__netinfra__backbone_link_entry):
        lr = conf.left_router
        li = conf.left_interface
        rr = conf.right_router
        ri = conf.right_interface
        dst = y_1_oper.dst(lambda r, e: on_inter_state(r, e, lr, li, rr, ri))
        entry = y_1_oper.subs.netinfra.backbone_link.entry(lr, li, rr, ri)
        want: set[gdata.Delivery] = set()
        want.add(dst.deliver({ entry.state.subscribe(period=5.0) }))
        _subs.declare(want)


class L3VpnVpnService(base.L3VpnVpnService):
    def transform(self, i):
        print("CFS L3VPN VPN Service transform running %s" % (i.vpn_id))
        customer_name = i.customer_name
        o = base.o_root()
        o.l3vpns.l3vpn.create(i.vpn_id, description="Customer VPN for %s" % customer_name if customer_name is not None else "")
        return o


actor L3VpnSiteTransform(path: ttt.Path, update_oper: proc(y_0_oper.ietf_l3vpn_svc__l3vpn_svc__sites__site_entry) -> None, lower_tree_provider: ?gdata.TreeProvider):
    # Lift inter endpoint telemetry into per-SNA site BGP session state.
    var _oper = base.L3VpnSite.new_state(path)
    _subs = gdata.SubscriptionManager(lower_tree_provider!, str(path))

    def _endpoint(bearer_ref: ?str) -> (?str, ?str):
        if bearer_ref is not None:
            parts = bearer_ref.split(",")
            if len(parts) == 2:
                return (parts[0], parts[1])
        return (None, None)

    def on_inter_state(root: ?y_1_oper.root, err: ?Exception, conf: y_0.ietf_l3vpn_svc__l3vpn_svc__sites__site_entry):
        if err is not None:
            print("cfs.L3VpnSiteTransform inter subscription error: {err}", err=True)
            return
        # Rebuild each delivery so removed/non-BGP SNAs clear from oper.
        _oper = base.L3VpnSite.new_state(path)
        for sna in conf.site_network_accesses.site_network_access:
            vpn_id = sna.vpn_attachment.vpn_id
            device, interface = _endpoint(sna.bearer.bearer_reference)
            if vpn_id is None or device is None or interface is None:
                continue
            found = False
            session_state: ?str = None
            last_event: ?str = None
            transitions: ?u64 = None
            debug_active: ?bool = None
            hold: ?u64 = None
            notification: ?str = None
            if root is not None:
                for vpn in root.l3vpns.l3vpn:
                    if vpn.name == vpn_id:
                        for ep in vpn.endpoint:
                            if ep.device == device and ep.interface == interface:
                                found = True
                                eps = ep.state
                                da = eps.debug_active
                                session_state = eps.session_state
                                debug_active = da
                                if da is not None and da:
                                    last_event = eps.last_event
                                    transitions = eps.established_transitions
                                    hold = eps.negotiated_hold_time
                                    notification = eps.last_notification
            if not found:
                # Non-BGP or not yet reported: avoid a key-only session entry.
                continue
            bs = _oper.bgp_sessions.bgp_session.create(sna.site_network_access_id)
            bs.session_state = session_state
            bs.debug_active = debug_active
            bs.last_event = last_event
            bs.established_transitions = transitions
            bs.negotiated_hold_time = hold
            bs.last_notification = notification
        update_oper(_oper)

    def on_conf(conf: y_0.ietf_l3vpn_svc__l3vpn_svc__sites__site_entry):
        want: set[gdata.Delivery] = set()
        dst = y_1_oper.dst(lambda r, e: on_inter_state(r, e, conf))
        specs: set[gdata.SubscriptionSpec] = set()
        for sna in conf.site_network_accesses.site_network_access:
            vpn_id = sna.vpn_attachment.vpn_id
            device, interface = _endpoint(sna.bearer.bearer_reference)
            if vpn_id is not None and device is not None and interface is not None:
                ep = y_1_oper.subs.l3vpns.l3vpn.entry(vpn_id).endpoint.entry(device, interface)
                specs.add(ep.state.subscribe(period=2.0))
        if len(specs) > 0:
            want.add(dst.deliver(specs))
        _subs.declare(want)
        if len(specs) == 0:
            _oper = base.L3VpnSite.new_state(path)
            update_oper(_oper)

class L3VpnSite(base.L3VpnSite):
    def transform(self, i):
        print("CFS L3VPN Site transform running %s" % (i.site_id))
        o = base.o_root()
        for sna in i.site_network_accesses.site_network_access:
            vpn_id = sna.vpn_attachment.vpn_id
            bearer_ref = sna.bearer.bearer_reference
            if bearer_ref is not None:
                parts = bearer_ref.split(",")
                device = parts[0]
                interface = parts[1]
            else:
                device, interface = None, None
            provider_ipv4_address = sna.ip_connection.ipv4.addresses.provider_address
            customer_ipv4_address = sna.ip_connection.ipv4.addresses.customer_address
            ipv4_len = sna.ip_connection.ipv4.addresses.prefix_length
            if vpn_id is not None and device is not None and interface is not None and provider_ipv4_address is not None and ipv4_len is not None:
                o_vpn = o.l3vpns.l3vpn.create(vpn_id)
                o_ep = o_vpn.endpoint.create((device, interface),
                    site=i.site_id,
                    site_network_access=sna.site_network_access_id,
                    provider_ipv4_address=provider_ipv4_address,
                    customer_ipv4_address=customer_ipv4_address,
                    ipv4_prefix_length=ipv4_len)

                for rp in sna.routing_protocols.routing_protocol:
                    if rp.type == y_0.ietf_l3vpn_svc_bgp:
                        bgp = rp.bgp
                        if bgp is not None:
                            o_ep.create_bgp(as_number=bgp.autonomous_system, authentication_key=bgp.authentication_key)

                # TODO: do the VRF ID split here too?! vpn-id acme-65501 -> 65501
                inter_l3vpn = o.netinfra.router.create(device).l3vpn_vrf.create(vpn_id)
                if customer_ipv4_address is not None:
                    inter_l3vpn.ebgp_customer_address.append(customer_ipv4_address)

        return o

class ROADM(base.ROADM):
    def transform(self, i):
        print("CFS roadm transform running", i.name, i.id)
        o = base.o_root()
        o_roadm = o.netinfra.roadm.create(i.name, id=i.id)
        return o

class OpticalLink(base.OpticalLink):
    def transform(self, i):
        print("CFS OpticalLink transform running %s [%s] <-> %s [%s]" % (i.left_roadm, i.left_port, i.right_roadm, i.right_port))
        o = base.o_root()
        ol = o.netinfra.optical_link.create((i.left_roadm, i.left_port, i.right_roadm, i.right_port))
        return o
