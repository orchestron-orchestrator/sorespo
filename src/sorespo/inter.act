import yang.adata
import yang.gdata as gdata
import stratoweave.ttt as ttt

import sorespo.layers.base_1 as base
import sorespo.layers.y_1 as y_1
import sorespo.layers.y_1_oper as y_1_oper
import sorespo.layers.y_2_oper as y_2_oper



def letter_position(letter):
    """
    Returns the position of the given letter in the English alphabet (1-26).
    """
    if len(letter) != 1 or not letter.isalpha():
        raise ValueError("Input must be a single alphabetic character.")
    letter = letter.lower()
    return ord(letter) - ord('a') + 1


class Router(base.Router):
    def transform(self, i):
        o = base.o_root()
        print("Intermediate router transform running", i.name, i.id)
        dev = o.device.create(i.name, type=i.type, approval_required=i.approval_required)
        dev.address.create("oob", address=i.name)
        dev.credentials.username = "clab"
        dev.credentials.password = "clab@123"
        dev.mock.enabled = i.mock
        dev.feature_flags.runtime_schema_fetch = i.feature_flags.runtime_schema_fetch

        sid = i.id
        rfs = o.rfs.create(i.name)
        rfs.base_config.role = i.role
        rfs.base_config.ipv4_address = i.base_config.ipv4_address
        rfs.base_config.ipv6_address = i.base_config.ipv6_address
        rfs.base_config.asn = i.base_config.asn

        # Inject router id, asn into rfs.Vrf, rfs.EbgpCustomer transform
        for vrf in i.l3vpn_vrf:
            rfs.vrf.create(vrf.vpn_id, router_id=sid, asn=i.base_config.asn)
            for ebgp_customer_address in vrf.ebgp_customer_address:
                rfs.ebgp_customer.create((vrf.vpn_id, ebgp_customer_address), local_asn=i.base_config.asn)

        return o


def combine_link_status(left: ?str, right: ?str) -> ?str:
    if left == "up" and right == "up":
        return "up"
    if left == "down" or right == "down":
        return "down"
    if left is None and right is None:
        return None
    return "unknown"


class BBLink(base.BBLink):
    # TODO: Bug here, when added linkedInput, does not execute anymore
    def transform(self, i, linked):
        print("Intermediate backbonelink transform running %s [%s] <-> %s [%s]" % (i.left_router, i.left_interface, i.right_router, i.right_interface))
        o = base.o_root()
        link_id = letter_position(i.left_router[0]) + letter_position(i.right_router[0])
        left_rfs = o.rfs.create(i.left_router)
        li = left_rfs.backbone_interface.create(i.left_interface, ipv4_address="10.0.{link_id}.1")
        li.remote.device = i.right_router
        li.remote.interface = i.right_interface

        right_rfs = o.rfs.create(i.right_router)
        ri = right_rfs.backbone_interface.create(i.right_interface, ipv4_address="10.0.{link_id}.2")
        ri.remote.device = i.left_router
        ri.remote.interface = i.left_interface

        if i.optical is not None:
            left_roadm_rfs = o.rfs.create(i.optical.left_roadm)
            lri = left_roadm_rfs.router_facing_roadm_interface.create(i.optical.left_port)
            lri.remote.router = i.left_router
            lri.remote.interface = i.left_interface

            right_roadm_rfs = o.rfs.create(i.optical.right_roadm)
            rri = right_roadm_rfs.router_facing_roadm_interface.create(i.optical.right_port)
            rri.remote.router = i.right_router
            rri.remote.interface = i.right_interface

            links = y_1.root.from_gdata(linked).netinfra.optical_link
            # TODO: based on len(otn-path)
            for link in links:
                # TODO: need testing
                print("Linkkkk %s" % link.left_roadm)
                # TODO: check also (left=right and right=left)?
                if i.optical.left_roadm == link.left_roadm and i.optical.right_roadm == link.right_roadm:
                    lor_rfs = o.rfs.create(i.optical.left_roadm)
                    lor_rfs.roadm_vlan.create(link.left_port, vlan=i.optical.vlan)

                    ror_rfs = o.rfs.create(i.optical.right_roadm)
                    ror_rfs.roadm_vlan.create(link.right_port, vlan=i.optical.vlan)
        return o


# --- Backbone link oper-status lift -------------------------------------------
# Combine the two endpoints' RFS backbone-interface oper-status into the
# backbone-link link-status (up only when both ends are up; see
# combine_link_status).
actor BBLinkTransform(path: ttt.Path,
                      update_oper: proc(?y_1_oper.netinfra_inter__netinfra__backbone_link_entry)->None,
                      lower_tree_provider: ?gdata.TreeProvider):
    _oper = base.BBLink.new_state(path)
    _subs = gdata.SubscriptionManager(lower_tree_provider!, str(path))

    def on_rfs_state(root: ?y_2_oper.root, err: ?Exception, left_router: str, left_interface: str, right_router: str, right_interface: str):
        if err is not None:
            print("inter.BBLinkTransform RFS subscription error: {err}", err=True)
            return
        left_status: ?str = None
        right_status: ?str = None
        if root is not None:
            for r in root.rfs:
                if r.name == left_router:
                    for bi in r.backbone_interface:
                        if bi.name == left_interface:
                            left_status = bi.state.oper_status
                if r.name == right_router:
                    for bi in r.backbone_interface:
                        if bi.name == right_interface:
                            right_status = bi.state.oper_status
        _oper.state.link_status = combine_link_status(left_status, right_status)
        update_oper(_oper)

    def on_conf(conf: y_1.netinfra_inter__netinfra__backbone_link_entry):
        lr = conf.left_router
        li = conf.left_interface
        rr = conf.right_router
        ri = conf.right_interface
        dst = y_2_oper.dst(lambda r, e: on_rfs_state(r, e, lr, li, rr, ri))
        want: set[gdata.Delivery] = set()
        want.add(dst.deliver({
            y_2_oper.subs.rfs.entry(lr).backbone_interface.entry(li).state.subscribe(period=5.0),
            y_2_oper.subs.rfs.entry(rr).backbone_interface.entry(ri).state.subscribe(period=5.0)
        }))
        _subs.declare(want)


class IbgpFullmesh(base.IbgpFullmesh):
    def transform(self, i):
        print("Intermediate ibgp-fullmesh transform running {i.asn}")
        o = base.o_root()
        for ra in i.router:
            rfs = o.rfs.create(ra.name)
            rfs.base_config.ibgp_authentication_key = i.authentication_key
            for rb in i.router:
                if ra.name == rb.name:
                    continue
                rfs.ibgp_neighbor.create(rb.ipv4_address, asn=i.asn, description=rb.name, ibgp_authentication_key=i.authentication_key)

        return o


actor L3VpnTransform(path: ttt.Path,
                      update_oper: proc(?y_1_oper.l3vpn_inter__l3vpns__l3vpn_entry)->None,
                      lower_tree_provider: ?gdata.TreeProvider):
    # Lift RFS eBGP customer session telemetry to inter endpoint state.
    var _oper = base.L3Vpn.new_state(path)
    _subs = gdata.SubscriptionManager(lower_tree_provider!, str(path))

    def on_rfs_state(root: ?y_2_oper.root, err: ?Exception, conf: y_1.l3vpn_inter__l3vpns__l3vpn_entry):
        if err is not None:
            print("inter.L3VpnTransform RFS subscription error: {err}", err=True)
            return
        # Rebuild each delivery so removed/BGP-disabled endpoints clear from oper.
        # Mirrors cfs.L3VpnSiteTransform.on_inter_state: the canonical lift shape.
        _oper = base.L3Vpn.new_state(path)
        vpn = conf.name
        for ep in conf.endpoint:
            addr = ep.customer_ipv4_address
            if ep.bgp is None or addr is None:
                continue
            found = False
            session_state: ?str = None
            last_event: ?str = None
            transitions: ?u64 = None
            debug_active: ?bool = None
            hold: ?u64 = None
            notification: ?str = None
            if root is not None:
                for r in root.rfs:
                    if r.name == ep.device:
                        for ec in r.ebgp_customer:
                            if ec.vrf == vpn and ec.address == addr:
                                found = True
                                ecs = ec.state
                                da = ecs.debug_active
                                session_state = ecs.session_state
                                debug_active = da
                                # Detail metrics are exposed only while debug is active.
                                if da is not None and da:
                                    last_event = ecs.last_event
                                    transitions = ecs.established_transitions
                                    hold = ecs.negotiated_hold_time
                                    notification = ecs.last_notification
            if not found:
                # RFS has not reported this neighbor yet: avoid a key-only entry.
                continue
            st = _oper.endpoint.create((ep.device, ep.interface)).state
            st.session_state = session_state
            st.debug_active = debug_active
            st.last_event = last_event
            st.established_transitions = transitions
            st.negotiated_hold_time = hold
            st.last_notification = notification
        update_oper(_oper)

    def on_conf(conf: y_1.l3vpn_inter__l3vpns__l3vpn_entry):
        want: set[gdata.Delivery] = set()
        vpn = conf.name
        dst = y_2_oper.dst(lambda r, e: on_rfs_state(r, e, conf))
        specs: set[gdata.SubscriptionSpec] = set()
        for ep in conf.endpoint:
            addr = ep.customer_ipv4_address
            if ep.bgp is not None and addr is not None:
                ec = y_2_oper.subs.rfs.entry(ep.device).ebgp_customer.entry(vpn, addr)
                specs.add(ec.state.subscribe(period=2.0))
        if len(specs) > 0:
            want.add(dst.deliver(specs))
        _subs.declare(want)
        if len(specs) == 0:
            _oper = base.L3Vpn.new_state(path)
            update_oper(_oper)


class L3Vpn(base.L3Vpn):
    def transform(self, i):
        print("Intermediate L3VPN transform running %s" % (i.name))
        o = base.o_root()

        for ep in i.endpoint:
            rfs = o.rfs.create(ep.device)

            # Get VRF id from vpn-id: acme-65501 -> 65501
            rfs.vrf.create(i.name, description=i.description, id=u64(i.name.split("-")[1]))

            rfs.vrf_interface.create(ep.interface,
                description="Customer VPN access %s [%s] in VPN %s" % (ep.site, ep.site_network_access, i.name),
                vrf=i.name,
                ipv4_address=ep.provider_ipv4_address,
                ipv4_prefix_length=ep.ipv4_prefix_length)

            customer_ipv4_address = ep.customer_ipv4_address
            bgp = ep.bgp
            if customer_ipv4_address is not None and bgp is not None:
                # local_asn is set in the inter.Router transform
                rfs.ebgp_customer.create((i.name, customer_ipv4_address),
                    peer_asn=bgp.as_number,
                    authentication_key=bgp.authentication_key,
                    description="Customer eBGP %s [%s] in VPN %s to %s" % (ep.site, ep.site_network_access, i.name, customer_ipv4_address))

        return o

class ROADM(base.ROADM):
    def transform(self, i):
        o = base.o_root()
        print("Intermediate roadm transform running", i.name, i.id)
        dev = o.device.create(i.name, type="NokiaSRLinux_25_3_2")
        dev.address.create("oob", address=i.name)
        dev.credentials.username = "clab"
        dev.credentials.password = "clab@123"
        return o

class OpticalLink(base.OpticalLink):
    def transform(self, i):
        o = base.o_root()
        print("CFS OpticalLink transform running %s [%s] <-> %s [%s]" % (i.left_roadm, i.left_port, i.right_roadm, i.right_port))

        left_rfs = o.rfs.create(i.left_roadm)
        li = left_rfs.roadm_roadm_interface.create(i.left_port)
        li.remote.device = i.right_roadm
        li.remote.interface = i.right_port

        right_rfs = o.rfs.create(i.right_roadm)
        ri = right_rfs.roadm_roadm_interface.create(i.right_port)
        ri.remote.device = i.left_roadm
        ri.remote.interface = i.left_port
        return o

