import testing
import std.xml as xml

import yang.adata
import yang.gdata as ygdata
import stratoweave.ttt

import sorespo.inter as inter
import sorespo.layers.y_1 as y_1

def _test_inter_bblink():
    xmlin = """
<backbone-link>
    <left-router>AMS-CORE-1</left-router>
    <left-interface>GigabitEthernet0/0/0/0</left-interface>
    <right-router>FRA-CORE-1</right-router>
    <right-interface>GigabitEthernet0/0/0/0</right-interface>
</backbone-link>"""
    transform = inter.BBLink()
    out, _ = transform.transform_xml(xml.decode(xmlin), ygdata.Container())
    return out.to_xmlstr()

def _test_inter_bblink_optical_vlan():
    xmlin = """
<backbone-link>
    <left-router>AMS-CORE-1</left-router>
    <left-interface>GigabitEthernet0/0/0/0</left-interface>
    <right-router>FRA-CORE-1</right-router>
    <right-interface>GigabitEthernet0/0/0/0</right-interface>
    <optical>
        <vlan>321</vlan>
        <left-roadm>AMS-ROADM-1</left-roadm>
        <right-roadm>FRA-ROADM-1</right-roadm>
        <left-port>ethernet-1/1</left-port>
        <right-port>ethernet-1/2</right-port>
    </optical>
</backbone-link>"""
    transform = inter.BBLink()
    out, _ = transform.transform_xml(xml.decode(xmlin), ygdata.Container())
    return out.to_xmlstr()

def _test_inter_optical_link_waits_for_ports():
    optical_link = y_1.netinfra_inter__netinfra__optical_link_entry(
        left_roadm="ROADM-1",
        right_roadm="ROADM-2",
        vlan=[100],
        left_port=None,
        right_port=None,
    )
    inter.OpticalLink().transform(optical_link)

def _test_inter_roadm_baseconfig():
    xmlin = """<roadm>
    <name>AMS-ROADM-1</name>
    <id>1</id>
</roadm>"""
    transform = inter.ROADM()
    out, _ = transform.transform_xml(xml.decode(xmlin), ygdata.Container())
    return out.to_xmlstr()

def _test_inter_ibgp_fullmesh():
    xmlin = """<ibgp-fullmesh>
    <asn>65001</asn>
    <authentication-key>secret</authentication-key>
    <router>
        <name>AMS-CORE-1</name>
        <ipv4-address>10.0.0.1</ipv4-address>
    </router>
    <router>
        <name>FRA-CORE-1</name>
        <ipv4-address>10.0.0.2</ipv4-address>
    </router>
    <router>
        <name>STO-CORE-1</name>
        <ipv4-address>10.0.0.3</ipv4-address>
    </router>
    <router>
        <name>LJU-CORE-1</name>
        <ipv4-address>10.0.0.4</ipv4-address>
    </router>
</ibgp-fullmesh>"""
    transform = inter.IbgpFullmesh()
    out, _ = transform.transform_xml(xml.decode(xmlin), ygdata.Container())
    return out.to_xmlstr()
