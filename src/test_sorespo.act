actor l3vpn_tester(t: testing.AsyncT, output_formatter: proc(swts.TestRig) -> str):
    tr = stratoweave.test_main(sysspec.SYSSPEC, t.log_handler)

    def cont(r: value):
        if isinstance(r, Exception):
            t.failure(r)
            return
        t.success(output_formatter(tr))

    tr.edit_config_xml(l3vpn_in, cont)

actor _test_l3vpn_svc(t: testing.AsyncT):
    l3vpn_tester(t, lambda tr: tr.layer_config(-1).to_xmlstr(deterministic=True))

actor _test_l3vpn_svc_json(t: testing.AsyncT):
    l3vpn_tester(t, lambda tr: tr.layer_config(-1).to_yang_jsonstr(deterministic=True))

actor _test_l3vpn_svc_adata(t: testing.AsyncT):
    def _lambda_workaround(tr):
        return tr.device_adata_snapshot()
    l3vpn_tester(t, _lambda_workaround)

